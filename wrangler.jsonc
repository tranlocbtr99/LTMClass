{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ltmclass",
  "main": "apps/api/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {"directory": "apps/web", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "ltmclass", "database_id": "REPLACE_AFTER_PROVISIONING", "migrations_dir": "db/migrations"}]
}
